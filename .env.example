# =============================================================
# Sobra — variáveis de ambiente
# Copie este arquivo para .env.local antes de rodar `npm run dev`
# =============================================================

# ----- Supabase (obrigatórias) -----
# Pegue em: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# Service role key — usada SOMENTE em rotinas server-side
# (cron de alertas, webhooks). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# ----- App (obrigatória em produção) -----
# Base URL usada nos magic links e callbacks de OAuth.
# Em dev, deixe http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Stripe (preencha quando começar a integrar pagamento) -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ----- Resend (preencha quando integrar e-mails) -----
RESEND_API_KEY=re_...

# ----- WhatsApp (Twilio ou Z-API — escolher um) -----
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Z-API (alternativa)
ZAPI_INSTANCE=
ZAPI_TOKEN=

# Número público que aparece na UI ("mande SOBRA-XXXXXX para...")
# Mostre o número formatado, ex: "+55 54 3698-3995"
NEXT_PUBLIC_SOBRA_WHATSAPP=+55 54 3698-3995

# ----- Anthropic (assistente IA via WhatsApp) -----
# Pegue em: https://console.anthropic.com/settings/keys
# Configurar via `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`
# (essa key fica só no Edge runtime, não no Next)
ANTHROPIC_API_KEY=
